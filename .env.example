# Environment Configuration Example
NODE_ENV=production
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=your-minimum-32-chars-long-jwt-secret
COOKIE_SECRET=your-minimum-32-chars-long-cookie-secret
ENCRYPTION_KEY=your-32-byte-hex-or-string-encryption-key
GMAIL_WEBHOOK_SECRET=your-gmail-webhook-secret
AI_SERVICE_URL=http://127.0.0.1:8001
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.com/api/mailbox/callback
ACM_CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/your-cert-uuid
CORS_ORIGINS=https://your-domain.com,http://localhost:3000

